        "expected_status": 200,
        "expected_json": {
          "uplink_packet_total": 3,
          "science_transmit_seconds": 12,
          "navigation_transmit_seconds": 10,
          "interference_seconds": 0,
          "transmit_seconds": 22,
          "antenna_capacity_seconds": 88,
          "sent_seconds": 22,
          "queued_seconds": 0,
          "transmission_windows": 0,
          "uplink_score": 22,
          "uplink_mode": "synchronized"
        }
      },
      {
        "id": "satellite_uplink_routine_queue",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/satellite-uplink",
        "json": {
          "science_packets": 8,
          "navigation_packets": 2,
          "ground_antennas": 1,
          "solar_interference": false
        },
        "expected_status": 200,
        "expected_json": {
          "uplink_packet_total": 10,
          "science_transmit_seconds": 48,
          "navigation_transmit_seconds": 20,
          "interference_seconds": 0,
          "transmit_seconds": 68,
          "antenna_capacity_seconds": 44,
          "sent_seconds": 44,
          "queued_seconds": 24,
          "transmission_windows": 2,
          "uplink_score": 236,
          "uplink_mode": "routine_queue"
        }
      },
      {
        "id": "satellite_uplink_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/satellite-uplink",
        "json": {
          "science_packets": 4,
          "navigation_packets": 3,
          "ground_antennas": 1,
          "solar_interference": true,
          "orbital_lane": 3
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "satellite_uplink_browser_sync",
        "visibility": "hidden",
        "target": "browser",
        "export": "satellite_uplink_score",
        "args": [
          2,
          1,
          2,
          false
        ],
        "expected": 22
      },
      {
        "id": "satellite_uplink_browser_routine",
        "visibility": "hidden",
        "target": "browser",
        "export": "satellite_uplink_score",
        "args": [
          8,
          2,
          1,
          false
        ],
        "expected": 236
      }
    ],
