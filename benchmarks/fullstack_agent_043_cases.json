{
  "schema_version": 1,
  "experiment_id": "043",
  "tasks": {
    "wildfire_drone_build": [
      {
        "id": "wildfire_drone_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/wildfire-drone-ready",
        "expected_status": 200,
        "expected_json": {
          "service": "Wildfire Drone",
          "ready": true
        }
      },
      {
        "id": "wildfire_drone_night_delay",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/wildfire-drone",
        "json": {
          "scout_drones": 2,
          "cargo_drones": 3,
          "launch_pads": 2,
          "night_mission": true
        },
        "expected_status": 200,
        "expected_json": {
          "drone_total": 5,
          "scout_flight_minutes": 26,
          "cargo_flight_minutes": 63,
          "night_setup_minutes": 16,
          "mission_load_minutes": 105,
          "launch_capacity_minutes": 100,
          "completed_flight_minutes": 100,
          "delayed_flight_minutes": 5,
          "flight_waves": 2,
          "wildfire_score": 148,
          "wildfire_mode": "night_delay"
        }
      },
      {
        "id": "wildfire_drone_wrong_pad_type",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "json": {
          "scout_drones": 2,
          "cargo_drones": 3,
          "launch_pads": true,
          "night_mission": true
        },
        "expected_status": 400,
        "expected_error": "invalid_json",
        "path": "/api/v7/wildfire-drone"
      },
      {
        "id": "wildfire_drone_browser_night",
        "visibility": "public",
        "target": "browser",
        "export": "wildfire_mission_score",
        "args": [
          2,
          3,
          2,
          true
        ],
        "expected": 148
      },
      {
        "id": "wildfire_drone_ready",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/wildfire-drone",
        "json": {
          "scout_drones": 1,
          "cargo_drones": 1,
          "launch_pads": 2,
          "night_mission": false
        },
        "expected_status": 200,
        "expected_json": {
          "drone_total": 2,
          "scout_flight_minutes": 13,
          "cargo_flight_minutes": 21,
          "night_setup_minutes": 0,
          "mission_load_minutes": 34,
          "launch_capacity_minutes": 100,
          "completed_flight_minutes": 34,
          "delayed_flight_minutes": 0,
          "flight_waves": 0,
          "wildfire_score": 34,
          "wildfire_mode": "ready"
        }
      },
      {
        "id": "wildfire_drone_day_delay",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/wildfire-drone",
        "json": {
          "scout_drones": 4,
          "cargo_drones": 3,
          "launch_pads": 2,
          "night_mission": false
        },
        "expected_status": 200,
        "expected_json": {
          "drone_total": 7,
          "scout_flight_minutes": 52,
          "cargo_flight_minutes": 63,
          "night_setup_minutes": 0,
          "mission_load_minutes": 115,
          "launch_capacity_minutes": 100,
          "completed_flight_minutes": 100,
          "delayed_flight_minutes": 15,
          "flight_waves": 2,
          "wildfire_score": 208,
          "wildfire_mode": "day_delay"
        }
      },
      {
        "id": "wildfire_drone_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/wildfire-drone",
        "json": {
          "scout_drones": 2,
          "cargo_drones": 3,
          "launch_pads": 2,
          "night_mission": true,
          "wind_sector": 4
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "wildfire_drone_browser_ready",
        "visibility": "hidden",
        "target": "browser",
        "export": "wildfire_mission_score",
        "args": [
          1,
          1,
          2,
          false
        ],
        "expected": 34
      },
      {
        "id": "wildfire_drone_browser_day",
        "visibility": "hidden",
        "target": "browser",
        "export": "wildfire_mission_score",
        "args": [
          4,
          3,
          2,
          false
        ],
        "expected": 208
