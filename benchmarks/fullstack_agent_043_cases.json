        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v7/satellite-uplink",
        "json": {
          "science_packets": 2,
          "navigation_packets": 1,
          "ground_antennas": 2,
          "solar_interference": false
