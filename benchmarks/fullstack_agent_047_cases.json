{
  "schema_version": 1,
  "experiment_id": "047",
  "visibility_policy": "Prompts expose only public case IDs and expected outcomes. Hidden cases remain parent-owned and never enter agent workspaces.",
  "tasks": {
    "tundra_probe_lookup_build": [
      {
        "id": "tundra_probe_lookup_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/tundra-probe-ready",
        "request_headers": {},
        "expected_status": 200,
        "expected_headers": {},
        "expected_json": {
          "service": "Tundra Probe Lookup",
          "ready": true
        },
        "expected_path_parameters": {}
      },
      {
        "id": "tundra_probe_lookup_exact",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/api/v11/tundra-probes/current",
        "request_headers": {},
        "expected_status": 200,
        "expected_headers": {
          "x-probe-state": "current"
        },
        "expected_json": {
          "probe_serial": "current",
          "probe_sequence": 47,
          "calibration_score": 611,
          "probe_state": "current"
        },
        "expected_path_parameters": {}
      },
      {
        "id": "tundra_probe_lookup_primary",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/api/v11/tundra-probes/18",
        "request_headers": {
          "x-tundra-pass": "tundra-047",
          "x-calibration-mode": "precision"
        },
        "expected_status": 200,
        "expected_headers": {
          "x-probe-state": "catalogued"
        },
        "expected_json": {
          "probe_serial": "18",
          "probe_sequence": 18,
          "calibration_score": 243,
          "probe_state": "catalogued"
        },
        "expected_path_parameters": {
          "probe_serial": "18"
        }
      },
      {
        "id": "tundra_probe_lookup_zero",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/api/v11/tundra-probes/0",
        "request_headers": {
          "x-tundra-pass": "tundra-047"
        },
        "expected_status": 422,
        "expected_headers": {
          "x-validation": "probe_serial"
        },
        "expected_json": {
          "probe_serial": "0",
          "probe_sequence": 0,
          "calibration_score": 0,
          "probe_state": "invalid"
        },
        "expected_path_parameters": {
          "probe_serial": "0"
        }
      },
      {
        "id": "tundra_probe_lookup_browser_primary",
        "visibility": "public",
        "target": "browser",
        "export": "tundra_calibration_score",
        "args": [
          18,
          true
        ],
        "expected": 243
      },
      {
        "id": "tundra_probe_lookup_unauthorized",
        "visibility": "hidden",
        "target": "http",
        "method": "GET",
        "path": "/api/v11/tundra-probes/18",
        "request_headers": {
          "x-calibration-mode": "precision"
        },
        "expected_status": 403,
        "expected_headers": {
          "x-access-denial": "tundra_pass"
        },
        "expected_json": {
          "probe_serial": "18",
          "probe_sequence": 0,
          "calibration_score": 0,
          "probe_state": "authorization_required"
        },
        "expected_path_parameters": {
          "probe_serial": "18"
        }
      },
      {
        "id": "tundra_probe_lookup_encoded",
        "visibility": "hidden",
        "target": "http",
        "method": "GET",
        "path": "/api/v11/tundra-probes/%34%32",
        "request_headers": {
          "x-tundra-pass": "tundra-047"
        },
        "expected_status": 200,
        "expected_headers": {
          "x-probe-state": "catalogued"
        },
        "expected_json": {
          "probe_serial": "42",
          "probe_sequence": 42,
          "calibration_score": 546,
          "probe_state": "catalogued"
        },
        "expected_path_parameters": {
          "probe_serial": "42"
        }
      },
      {
        "id": "tundra_probe_lookup_invalid_escape",
        "visibility": "hidden",
        "target": "http",
        "method": "GET",
        "path": "/api/v11/tundra-probes/%ZZ",
        "request_headers": {
          "x-tundra-pass": "tundra-047"
        },
        "expected_status": 400,
        "expected_headers": {},
        "expected_error": "invalid_path_parameter"
      },
      {
        "id": "tundra_probe_lookup_browser_hidden_1",
        "visibility": "hidden",
        "target": "browser",
        "export": "tundra_calibration_score",
        "args": [
          7,
          false
        ],
        "expected": 91
      },
      {
