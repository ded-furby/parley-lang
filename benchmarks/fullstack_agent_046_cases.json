{
  "schema_version": 1,
  "experiment_id": "046",
  "visibility_policy": "Prompts expose only public case IDs and expected outcomes. Hidden cases remain parent-owned and are never placed in agent workspaces.",
  "tasks": {
    "orbital_clearance_build": [
      {
        "id": "orbital_clearance_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/orbital-clearance-ready",
        "expected_status": 200,
        "expected_json": {
          "service": "Orbital Cargo Clearance",
          "ready": true
        },
        "expected_headers": {}
      },
      {
        "id": "orbital_clearance_primary",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v10/orbital-clearances",
        "json": {
          "clearance_slug": "zenith-4",
          "pressurized_pods": 3,
          "vacuum_pods": 2,
          "docking_arms": 2,
          "solar_flare": true
        },
        "request_headers": {
          "X-Orbit-Credential": "orbit-046"
        },
        "expected_status": 207,
        "expected_json": {
          "clearance_slug": "zenith-4",
          "payload_tally": 5,
          "transfer_effort": 62,
          "berth_allowance": 94,
          "approved_effort": 62,
          "spillover_effort": 0,
          "orbit_passes": 2,
          "clearance_rating": 74,
          "clearance_phase": "cleared"
        },
        "expected_headers": {
          "location": "/api/v10/orbital-clearances/zenith-4",
          "x-clearance-phase": "cleared"
        }
      },
      {
        "id": "orbital_clearance_wrong_vacuum_type",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "json": {
          "clearance_slug": "zenith-4",
          "pressurized_pods": 3,
          "vacuum_pods": true,
          "docking_arms": 2,
          "solar_flare": true
        },
        "request_headers": {
          "x-orbit-credential": "orbit-046"
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "orbital_clearance_browser_primary",
        "visibility": "public",
        "target": "browser",
        "export": "orbital_clearance_rating",
        "args": [
          3,
          2,
          2,
          true
        ],
        "expected": 74
      },
      {
        "id": "orbital_clearance_unauthorized",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v10/orbital-clearances",
        "json": {
          "clearance_slug": "zenith-4",
          "pressurized_pods": 3,
          "vacuum_pods": 2,
          "docking_arms": 2,
          "solar_flare": true
        },
        "request_headers": {},
        "expected_status": 403,
        "expected_json": {
          "clearance_slug": "zenith-4",
          "payload_tally": 0,
          "transfer_effort": 0,
          "berth_allowance": 0,
          "approved_effort": 0,
          "spillover_effort": 0,
          "orbit_passes": 0,
          "clearance_rating": 0,
          "clearance_phase": "authorization_required"
        },
        "expected_headers": {
          "x-access-denial": "orbit_credential"
        }
      },
      {
        "id": "orbital_clearance_zero_arms",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v10/orbital-clearances",
        "json": {
          "clearance_slug": "nadir-2",
          "pressurized_pods": 1,
          "vacuum_pods": 2,
          "docking_arms": 0,
          "solar_flare": false
        },
        "request_headers": {
          "x-orbit-credential": "orbit-046"
        },
        "expected_status": 422,
        "expected_json": {
          "clearance_slug": "nadir-2",
          "payload_tally": 0,
          "transfer_effort": 0,
          "berth_allowance": 0,
          "approved_effort": 0,
          "spillover_effort": 0,
          "orbit_passes": 0,
          "clearance_rating": 0,
          "clearance_phase": "invalid"
        },
        "expected_headers": {
          "x-validation": "docking_arms"
        }
      },
      {
        "id": "orbital_clearance_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v10/orbital-clearances",
        "json": {
          "clearance_slug": "zenith-4",
          "pressurized_pods": 3,
          "vacuum_pods": 2,
          "docking_arms": 2,
          "solar_flare": true,
          "cargo_latch": 3
        },
        "request_headers": {
          "X-Orbit-Credential": "orbit-046"
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "orbital_clearance_browser_hidden_1",
        "visibility": "hidden",
        "target": "browser",
        "export": "orbital_clearance_rating",
        "args": [
          1,
          1,
          2,
          false
        ],
        "expected": 28
      },
      {
        "id": "orbital_clearance_browser_hidden_2",
        "visibility": "hidden",
        "target": "browser",
        "export": "orbital_clearance_rating",
        "args": [
          7,
          4,
          1,
          true
        ],
        "expected": 555
      }
    ],
    "estuary_assay_build": [
      {
        "id": "estuary_assay_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/estuary-assay-ready",
