        "expected_json": {"nursery_trays": 7, "base_flow_liters": 69, "night_flush_liters": 10, "required_flow_liters": 79, "pump_capacity_liters": 40, "served_flow_liters": 40, "overflow_flow_liters": 39, "reef_index": 403, "nursery_state": "night_overflow"}
