{
  "schema_version": 1,
  "experiment_id": "041",
  "tasks": {
    "observatory_schedule_build": [
      {
        "id": "observatory_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/observatory-ready",
        "expected_status": 200,
        "expected_json": {"service": "Observatory Schedule", "ready": true}
      },
      {
        "id": "observatory_outreach_day",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/observatory-schedule",
        "json": {"public_talks": 4, "research_tracks": 2, "dome_sections": 3, "cloud_monitoring": false},
        "expected_status": 200,
        "expected_json": {"session_total": 6, "open_minutes": 150, "weather_minutes": 0, "scheduled_minutes": 150, "staff_minutes": 450, "rest_breaks": 1, "coordination_score": 493, "observatory_mode": "outreach"}
      },
      {
        "id": "observatory_wrong_monitoring_type",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/observatory-schedule",
        "json": {"public_talks": 4, "research_tracks": 2, "dome_sections": 3, "cloud_monitoring": 1},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "observatory_browser_outreach",
        "visibility": "public",
        "target": "browser",
        "export": "observatory_coordination_score",
        "args": [4, 2, 3, false],
        "expected": 493
      },
      {
        "id": "observatory_research_clouds",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/observatory-schedule",
        "json": {"public_talks": 1, "research_tracks": 4, "dome_sections": 2, "cloud_monitoring": true},
        "expected_status": 200,
        "expected_json": {"session_total": 5, "open_minutes": 146, "weather_minutes": 14, "scheduled_minutes": 160, "staff_minutes": 320, "rest_breaks": 1, "coordination_score": 358, "observatory_mode": "research_first"}
      },
      {
        "id": "observatory_standby_watch",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/observatory-schedule",
        "json": {"public_talks": 0, "research_tracks": 0, "dome_sections": 4, "cloud_monitoring": true},
        "expected_status": 200,
        "expected_json": {"session_total": 0, "open_minutes": 0, "weather_minutes": 28, "scheduled_minutes": 28, "staff_minutes": 112, "rest_breaks": 0, "coordination_score": 112, "observatory_mode": "standby"}
      },
      {
        "id": "observatory_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/observatory-schedule",
        "json": {"public_talks": 4, "research_tracks": 2, "dome_sections": 3, "cloud_monitoring": false, "mirror_count": 2},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "observatory_browser_research",
        "visibility": "hidden",
        "target": "browser",
        "export": "observatory_coordination_score",
        "args": [1, 4, 2, true],
        "expected": 358
      },
      {
        "id": "observatory_browser_standby",
        "visibility": "hidden",
        "target": "browser",
        "export": "observatory_coordination_score",
        "args": [0, 0, 4, true],
        "expected": 112
      }
    ],
    "reef_nursery_build": [
      {
        "id": "reef_status",
        "visibility": "public",
        "target": "http",
