      {
        "id": "reef_night_balanced",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/reef-nursery",
        "json": {"coral_trays": 1, "algae_trays": 1, "circulation_pumps": 2, "night_cycle": true},
        "expected_status": 200,
        "expected_json": {"nursery_trays": 2, "base_flow_liters": 19, "night_flush_liters": 10, "required_flow_liters": 29, "pump_capacity_liters": 40, "served_flow_liters": 29, "overflow_flow_liters": 0, "reef_index": 32, "nursery_state": "balanced"}
      },
      {
        "id": "reef_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v5/reef-nursery",
        "json": {"coral_trays": 2, "algae_trays": 4, "circulation_pumps": 3, "night_cycle": false, "salinity": 7},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "reef_browser_overflow",
        "visibility": "hidden",
        "target": "browser",
        "export": "reef_nursery_index",
        "args": [4, 3, 2, true],
        "expected": 403
      },
      {
        "id": "reef_browser_night_balanced",
        "visibility": "hidden",
        "target": "browser",
        "export": "reef_nursery_index",
        "args": [1, 1, 2, true],
