        "target": "http",
        "method": "POST",
        "path": "/api/v4/rooftop-battery",
        "json": {"solar_units": 2, "household_units": 10, "stored_units": 10, "reserve_enabled": true},
        "expected_status": 200,
        "expected_json": {"energy_gap": 8, "protected_units": 4, "discharge_ceiling": 6, "battery_delivery": 6, "utility_units": 2, "storage_balance": 4, "reserve_margin": 0, "supply_state": "grid"}
