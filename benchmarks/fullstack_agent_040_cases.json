        "path": "/api/v4/bookmobile-loading",
        "json": {"requested_crates": 35, "damaged_crates": 3, "truck_count": 2, "lift_assist": true},
        "expected_status": 200,
        "expected_json": {"sound_crates": 32, "deck_slots": 32, "lift_slots": 4, "loading_slots": 36, "deferred_crates": 0, "boarded_crates": 32, "empty_slots": 4, "loading_state": "loaded"}
