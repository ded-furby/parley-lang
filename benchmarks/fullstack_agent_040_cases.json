      {
        "id": "rooftop_missing_field",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v4/rooftop-battery",
        "json": {"solar_units": 2, "household_units": 10, "stored_units": 10},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "rooftop_browser_reserve",
        "visibility": "public",
        "target": "browser",
        "export": "rooftop_utility_draw",
        "args": [2, 10, 10, true],
        "expected": 2
      },
      {
        "id": "rooftop_no_reserve",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v4/rooftop-battery",
        "json": {"solar_units": 1, "household_units": 8, "stored_units": 3, "reserve_enabled": false},
        "expected_status": 200,
        "expected_json": {"energy_gap": 7, "protected_units": 0, "discharge_ceiling": 3, "battery_delivery": 3, "utility_units": 4, "storage_balance": 0, "reserve_margin": 0, "supply_state": "grid"}
      },
      {
        "id": "rooftop_battery_covers_gap",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v4/rooftop-battery",
        "json": {"solar_units": 5, "household_units": 8, "stored_units": 10, "reserve_enabled": true},
        "expected_status": 200,
        "expected_json": {"energy_gap": 3, "protected_units": 4, "discharge_ceiling": 6, "battery_delivery": 3, "utility_units": 0, "storage_balance": 7, "reserve_margin": 3, "supply_state": "battery"}
      },
      {
        "id": "rooftop_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v4/rooftop-battery",
        "json": {"solar_units": 2, "household_units": 10, "stored_units": 10, "reserve_enabled": true, "meter": 1},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "rooftop_browser_grid",
        "visibility": "hidden",
        "target": "browser",
        "export": "rooftop_utility_draw",
        "args": [1, 8, 3, false],
        "expected": 4
      },
      {
        "id": "rooftop_browser_battery",
        "visibility": "hidden",
        "target": "browser",
        "export": "rooftop_utility_draw",
        "args": [5, 8, 10, true],
        "expected": 0
      }
    ],
    "bookmobile_loading_repair": [
      {
