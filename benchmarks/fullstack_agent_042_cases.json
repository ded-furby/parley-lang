{
  "schema_version": 1,
  "experiment_id": "042",
  "tasks": {
    "radio_archive_build": [
      {
        "id": "radio_archive_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/radio-archive-ready",
        "expected_status": 200,
        "expected_json": {"service": "Radio Archive", "ready": true}
      },
      {
        "id": "radio_archive_live_multilingual",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/radio-archive",
        "json": {"spoken_segments": 3, "music_segments": 2, "language_tracks": 2, "live_broadcast": true},
        "expected_status": 200,
        "expected_json": {"segment_total": 5, "speech_megabytes": 42, "music_megabytes": 48, "translation_megabytes": 18, "archive_megabytes": 108, "replica_megabytes": 216, "upload_blocks": 1, "archive_score": 248, "archive_mode": "multilingual_live"}
      },
      {
        "id": "radio_archive_wrong_language_type",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/radio-archive",
        "json": {"spoken_segments": 3, "music_segments": 2, "language_tracks": false, "live_broadcast": true},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "radio_archive_browser_multilingual",
        "visibility": "public",
        "target": "browser",
        "export": "radio_archive_score",
        "args": [3, 2, 2, true],
        "expected": 248
      },
      {
        "id": "radio_archive_catalog",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/radio-archive",
        "json": {"spoken_segments": 2, "music_segments": 1, "language_tracks": 1, "live_broadcast": false},
        "expected_status": 200,
        "expected_json": {"segment_total": 3, "speech_megabytes": 28, "music_megabytes": 24, "translation_megabytes": 0, "archive_megabytes": 52, "replica_megabytes": 52, "upload_blocks": 0, "archive_score": 61, "archive_mode": "catalog"}
      },
      {
        "id": "radio_archive_live_single",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/radio-archive",
        "json": {"spoken_segments": 1, "music_segments": 3, "language_tracks": 1, "live_broadcast": true},
        "expected_status": 200,
        "expected_json": {"segment_total": 4, "speech_megabytes": 14, "music_megabytes": 72, "translation_megabytes": 9, "archive_megabytes": 95, "replica_megabytes": 95, "upload_blocks": 1, "archive_score": 124, "archive_mode": "live"}
      },
      {
        "id": "radio_archive_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/radio-archive",
        "json": {"spoken_segments": 3, "music_segments": 2, "language_tracks": 2, "live_broadcast": true, "studio_floor": 4},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "radio_archive_browser_catalog",
        "visibility": "hidden",
        "target": "browser",
        "export": "radio_archive_score",
        "args": [2, 1, 1, false],
        "expected": 61
      },
      {
        "id": "radio_archive_browser_live_single",
        "visibility": "hidden",
        "target": "browser",
        "export": "radio_archive_score",
        "args": [1, 3, 1, true],
        "expected": 124
      }
    ],
    "theatre_turnaround_build": [
      {
        "id": "theatre_turnaround_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/theatre-ready",
        "expected_status": 200,
        "expected_json": {"service": "Theatre Turnaround", "ready": true}
      },
      {
        "id": "theatre_turnaround_on_time",
