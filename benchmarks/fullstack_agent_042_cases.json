      {
        "id": "theatre_turnaround_repertory_delay",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/theatre-turnaround",
        "json": {"matinee_shows": 4, "evening_shows": 2, "stage_crews": 2, "touring_production": false},
        "expected_status": 200,
        "expected_json": {"show_total": 6, "base_reset_minutes": 126, "touring_minutes": 0, "required_minutes": 126, "crew_capacity_minutes": 90, "covered_minutes": 90, "delayed_minutes": 36, "handoff_windows": 4, "turnaround_score": 422, "turnaround_state": "repertory_delay"}
      },
      {
        "id": "theatre_turnaround_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v6/theatre-turnaround",
        "json": {"matinee_shows": 2, "evening_shows": 1, "stage_crews": 2, "touring_production": false, "curtain_weight": 3},
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "theatre_turnaround_browser_touring",
        "visibility": "hidden",
        "target": "browser",
        "export": "theatre_turnaround_score",
        "args": [1, 3, 2, true],
        "expected": 291
      },
      {
        "id": "theatre_turnaround_browser_repertory",
        "visibility": "hidden",
        "target": "browser",
        "export": "theatre_turnaround_score",
        "args": [4, 2, 2, false],
        "expected": 422
      }
