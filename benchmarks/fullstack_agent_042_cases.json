        "target": "http",
        "method": "POST",
        "path": "/api/v6/theatre-turnaround",
        "json": {"matinee_shows": 2, "evening_shows": 1, "stage_crews": 2, "touring_production": false},
        "expected_status": 200,
        "expected_json": {"show_total": 3, "base_reset_minutes": 63, "touring_minutes": 0, "required_minutes": 63, "crew_capacity_minutes": 90, "covered_minutes": 63, "delayed_minutes": 0, "handoff_windows": 2, "turnaround_score": 85, "turnaround_state": "on_time"}
