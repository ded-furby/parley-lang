        "target": "http",
        "method": "POST",
        "path": "/api/v6/theatre-turnaround",
        "raw_body": "{}",
        "content_type": "text/plain",
        "expected_status": 415,
        "expected_error": "json_content_type_required"
      },
      {
        "id": "theatre_turnaround_browser_on_time",
        "visibility": "public",
        "target": "browser",
