        "json": {"matinee_shows": 1, "evening_shows": 3, "stage_crews": 2, "touring_production": true},
        "expected_status": 200,
        "expected_json": {"show_total": 4, "base_reset_minutes": 99, "touring_minutes": 12, "required_minutes": 111, "crew_capacity_minutes": 90, "covered_minutes": 90, "delayed_minutes": 21, "handoff_windows": 3, "turnaround_score": 291, "turnaround_state": "touring_delay"}
