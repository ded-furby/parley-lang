      },
      {
        "id": "museum_conservation_routine_queue",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/museum-conservation",
        "json": {
          "canvas_crates": 5,
          "textile_crates": 3,
          "work_tables": 2,
          "emergency_drying": false
        },
        "expected_status": 200,
        "expected_json": {
          "crate_total": 8,
          "canvas_work_minutes": 45,
          "textile_work_minutes": 45,
          "drying_setup_minutes": 0,
          "conservation_required_minutes": 90,
          "table_capacity_minutes": 86,
          "completed_minutes": 86,
          "deferred_minutes": 4,
          "conservation_rounds": 2,
          "conservation_score": 136,
          "conservation_state": "routine_queue"
        }
      },
      {
        "id": "museum_conservation_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/museum-conservation",
        "json": {
          "canvas_crates": 3,
          "textile_crates": 2,
          "work_tables": 1,
          "emergency_drying": true,
          "gallery_wing": 3
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "museum_conservation_browser_preserved",
        "visibility": "hidden",
        "target": "browser",
        "export": "museum_conservation_score",
        "args": [
          1,
          1,
          2,
          false
        ],
        "expected": 24
      },
      {
        "id": "museum_conservation_browser_routine",
        "visibility": "hidden",
        "target": "browser",
        "export": "museum_conservation_score",
        "args": [
          5,
          3,
          2,
          false
        ],
        "expected": 136
      }
    ],
    "canal_lock_repair": [
