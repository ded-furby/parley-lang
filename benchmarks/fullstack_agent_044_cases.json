{
  "schema_version": 1,
  "experiment_id": "044",
  "tasks": {
    "seismic_array_build": [
      {
        "id": "seismic_array_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/seismic-array-ready",
        "expected_status": 200,
        "expected_json": {
          "service": "Seismic Array",
          "ready": true
        }
      },
      {
        "id": "seismic_array_ash_backlog",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/seismic-array",
        "json": {
          "short_sensors": 2,
          "deep_sensors": 3,
          "relay_towers": 2,
          "ash_warning": true
        },
        "expected_status": 200,
        "expected_json": {
          "sensor_total": 5,
          "short_scan_seconds": 24,
          "deep_scan_seconds": 60,
          "ash_sync_seconds": 14,
          "array_required_seconds": 98,
          "relay_capacity_seconds": 96,
          "processed_seconds": 96,
          "backlogged_seconds": 2,
          "scan_rounds": 2,
          "array_score": 128,
          "array_state": "ash_backlog"
        }
      },
      {
        "id": "seismic_array_wrong_relay_type",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "json": {
          "short_sensors": 2,
          "deep_sensors": 3,
          "relay_towers": true,
          "ash_warning": true
        },
        "expected_status": 400,
        "expected_error": "invalid_json",
        "path": "/api/v8/seismic-array"
      },
      {
        "id": "seismic_array_browser_ash",
        "visibility": "public",
        "target": "browser",
        "export": "seismic_array_score",
        "args": [
          2,
          3,
          2,
          true
        ],
        "expected": 128
      },
      {
        "id": "seismic_array_aligned",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/seismic-array",
        "json": {
          "short_sensors": 1,
          "deep_sensors": 1,
          "relay_towers": 2,
          "ash_warning": false
        },
        "expected_status": 200,
        "expected_json": {
          "sensor_total": 2,
          "short_scan_seconds": 12,
          "deep_scan_seconds": 20,
          "ash_sync_seconds": 0,
          "array_required_seconds": 32,
          "relay_capacity_seconds": 96,
          "processed_seconds": 32,
          "backlogged_seconds": 0,
          "scan_rounds": 0,
          "array_score": 32,
          "array_state": "aligned"
        }
      },
      {
        "id": "seismic_array_routine_backlog",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/seismic-array",
        "json": {
          "short_sensors": 4,
          "deep_sensors": 3,
          "relay_towers": 2,
          "ash_warning": false
        },
        "expected_status": 200,
        "expected_json": {
          "sensor_total": 7,
          "short_scan_seconds": 48,
          "deep_scan_seconds": 60,
          "ash_sync_seconds": 0,
          "array_required_seconds": 108,
          "relay_capacity_seconds": 96,
          "processed_seconds": 96,
          "backlogged_seconds": 12,
          "scan_rounds": 2,
          "array_score": 188,
          "array_state": "routine_backlog"
        }
      },
      {
        "id": "seismic_array_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/seismic-array",
        "json": {
          "short_sensors": 2,
          "deep_sensors": 3,
          "relay_towers": 2,
          "ash_warning": true,
          "magma_band": 4
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "seismic_array_browser_aligned",
        "visibility": "hidden",
        "target": "browser",
        "export": "seismic_array_score",
        "args": [
          1,
          1,
          2,
          false
        ],
        "expected": 32
      },
      {
        "id": "seismic_array_browser_routine",
        "visibility": "hidden",
        "target": "browser",
        "export": "seismic_array_score",
        "args": [
          4,
          3,
          2,
          false
        ],
        "expected": 188
      }
    ],
    "museum_conservation_build": [
      {
        "id": "museum_conservation_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/museum-conservation-ready",
        "expected_status": 200,
        "expected_json": {
          "service": "Museum Conservation",
          "ready": true
        }
      },
      {
        "id": "museum_conservation_emergency_queue",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v8/museum-conservation",
        "json": {
          "canvas_crates": 3,
          "textile_crates": 2,
          "work_tables": 1,
          "emergency_drying": true
        },
        "expected_status": 200,
        "expected_json": {
          "crate_total": 5,
          "canvas_work_minutes": 27,
          "textile_work_minutes": 30,
          "drying_setup_minutes": 6,
          "conservation_required_minutes": 63,
          "table_capacity_minutes": 43,
          "completed_minutes": 43,
          "deferred_minutes": 20,
          "conservation_rounds": 1,
          "conservation_score": 194,
          "conservation_state": "emergency_queue"
        }
      },
      {
        "id": "museum_conservation_wrong_media",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "raw_body": "{}",
        "content_type": "text/plain",
        "expected_status": 415,
        "expected_error": "json_content_type_required",
        "path": "/api/v8/museum-conservation"
      },
      {
        "id": "museum_conservation_browser_emergency",
        "visibility": "public",
        "target": "browser",
        "export": "museum_conservation_score",
        "args": [
          3,
          2,
          1,
          true
        ],
        "expected": 194
      },
      {
