{
  "schema_version": 1,
  "experiment_id": "045",
  "visibility_policy": "Prompts expose only public case IDs and expected outcomes. Hidden cases remain parent-owned and are never placed in agent workspaces.",
  "tasks": {
    "artifact_accession_build": [
      {
        "id": "artifact_accession_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/artifact-accession-ready",
        "expected_status": 200,
        "expected_json": {
          "service": "Artifact Accession",
          "ready": true
        },
        "expected_headers": {}
      },
      {
        "id": "artifact_accession_primary",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/artifact-accessions",
        "json": {
          "accession_key": "bronze-lyre",
          "stable_units": 3,
          "fragile_units": 2,
          "packing_stations": 2,
          "expedited": true
        },
        "request_headers": {
          "authorization": "Bearer accession-045"
        },
        "expected_status": 201,
        "expected_json": {
          "accession_key": "bronze-lyre",
          "artifact_total": 5,
          "packing_units": 48,
          "capacity_units": 80,
          "overflow_units": 0,
          "inspection_rounds": 1,
          "priority_score": 55,
          "accession_state": "accepted"
        },
        "expected_headers": {
          "location": "/api/v9/artifact-accessions/bronze-lyre",
          "x-accession-state": "accepted"
        }
      },
      {
        "id": "artifact_accession_wrong_fragile_type",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "json": {
          "accession_key": "bronze-lyre",
          "stable_units": 3,
          "fragile_units": true,
          "packing_stations": 2,
          "expedited": true
        },
        "request_headers": {
          "authorization": "Bearer accession-045"
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "artifact_accession_browser_primary",
        "visibility": "public",
        "target": "browser",
        "export": "artifact_priority_score",
        "args": [
          3,
          2,
          2,
          true
        ],
        "expected": 55
      },
      {
        "id": "artifact_accession_unauthorized",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/artifact-accessions",
        "json": {
          "accession_key": "bronze-lyre",
          "stable_units": 3,
          "fragile_units": 2,
          "packing_stations": 2,
          "expedited": true
        },
        "request_headers": {},
        "expected_status": 401,
        "expected_json": {
          "accession_key": "bronze-lyre",
          "artifact_total": 0,
          "packing_units": 0,
          "capacity_units": 0,
          "overflow_units": 0,
          "inspection_rounds": 0,
          "priority_score": 0,
          "accession_state": "authorization_required"
        },
        "expected_headers": {
          "www-authenticate": "Bearer realm=artifact-accession"
        }
      },
      {
        "id": "artifact_accession_zero_stations",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/artifact-accessions",
        "json": {
          "accession_key": "marble-4",
          "stable_units": 2,
          "fragile_units": 1,
          "packing_stations": 0,
          "expedited": false
        },
        "request_headers": {
          "authorization": "Bearer accession-045"
        },
        "expected_status": 422,
        "expected_json": {
          "accession_key": "marble-4",
          "artifact_total": 0,
          "packing_units": 0,
          "capacity_units": 0,
          "overflow_units": 0,
          "inspection_rounds": 0,
          "priority_score": 0,
          "accession_state": "invalid"
        },
        "expected_headers": {
          "x-validation": "packing_stations"
        }
      },
      {
        "id": "artifact_accession_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/artifact-accessions",
        "json": {
          "accession_key": "bronze-lyre",
          "stable_units": 3,
          "fragile_units": 2,
          "packing_stations": 2,
          "expedited": true,
          "gallery_code": "west"
        },
        "request_headers": {
          "authorization": "Bearer accession-045"
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "artifact_accession_browser_hidden_1",
        "visibility": "hidden",
        "target": "browser",
        "export": "artifact_priority_score",
        "args": [
          1,
          1,
          2,
          false
        ],
        "expected": 17
      },
      {
        "id": "artifact_accession_browser_hidden_2",
        "visibility": "hidden",
        "target": "browser",
        "export": "artifact_priority_score",
        "args": [
          6,
          4,
          1,
          true
        ],
        "expected": 318
      }
    ],
    "microgrid_bid_build": [
      {
        "id": "microgrid_bid_status",
        "visibility": "public",
        "target": "http",
        "method": "GET",
        "path": "/status/microgrid-bid-ready",
        "expected_status": 200,
        "expected_json": {
          "service": "Microgrid Bid",
          "ready": true
        },
        "expected_headers": {}
      },
      {
        "id": "microgrid_bid_primary",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/microgrid-bids",
        "json": {
          "bid_key": "sunset-7",
          "solar_arrays": 3,
          "wind_turbines": 2,
          "storage_banks": 2,
          "interconnects": 2,
          "emergency_mode": true,
          "duplicate_bid": false
        },
        "request_headers": {
          "x-grid-key": "grid-045"
        },
        "expected_status": 202,
        "expected_json": {
          "bid_key": "sunset-7",
          "generation_units": 53,
          "battery_buffer_units": 14,
          "grid_required_units": 67,
          "grid_capacity_units": 110,
          "delivered_units": 67,
          "shortfall_units": 0,
          "dispatch_windows": 2,
          "bid_score": 85,
          "bid_state": "accepted"
        },
        "expected_headers": {
          "location": "/api/v9/microgrid-bids/sunset-7",
          "retry-after": "3",
          "x-bid-state": "accepted"
        }
      },
      {
        "id": "microgrid_bid_wrong_media",
        "visibility": "public",
        "target": "http",
        "method": "POST",
        "raw_body": "{}",
        "content_type": "text/plain",
        "request_headers": {
          "x-grid-key": "grid-045"
        },
        "expected_status": 415,
        "expected_error": "json_content_type_required"
      },
      {
        "id": "microgrid_bid_browser_primary",
        "visibility": "public",
        "target": "browser",
        "export": "microgrid_bid_score",
        "args": [
          3,
          2,
          2,
          2,
          true
        ],
        "expected": 85
      },
      {
        "id": "microgrid_bid_duplicate",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/microgrid-bids",
        "json": {
          "bid_key": "sunset-7",
          "solar_arrays": 3,
          "wind_turbines": 2,
          "storage_banks": 2,
          "interconnects": 2,
          "emergency_mode": true,
          "duplicate_bid": true
        },
        "request_headers": {
          "x-grid-key": "grid-045"
        },
        "expected_status": 409,
        "expected_json": {
          "bid_key": "sunset-7",
          "generation_units": 0,
          "battery_buffer_units": 0,
          "grid_required_units": 0,
          "grid_capacity_units": 0,
          "delivered_units": 0,
          "shortfall_units": 0,
          "dispatch_windows": 0,
          "bid_score": 0,
          "bid_state": "duplicate"
        },
        "expected_headers": {
          "x-conflict": "duplicate_bid"
        }
      },
      {
        "id": "microgrid_bid_zero_interconnect",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/microgrid-bids",
        "json": {
          "bid_key": "island-3",
          "solar_arrays": 1,
          "wind_turbines": 2,
          "storage_banks": 1,
          "interconnects": 0,
          "emergency_mode": false,
          "duplicate_bid": false
        },
        "request_headers": {
          "x-grid-key": "grid-045"
        },
        "expected_status": 422,
        "expected_json": {
          "bid_key": "island-3",
          "generation_units": 0,
          "battery_buffer_units": 0,
          "grid_required_units": 0,
          "grid_capacity_units": 0,
          "delivered_units": 0,
          "shortfall_units": 0,
          "dispatch_windows": 0,
          "bid_score": 0,
          "bid_state": "invalid"
        },
        "expected_headers": {
          "x-validation": "interconnects"
        }
      },
      {
        "id": "microgrid_bid_unknown_field",
        "visibility": "hidden",
        "target": "http",
        "method": "POST",
        "path": "/api/v9/microgrid-bids",
        "json": {
          "bid_key": "sunset-7",
          "solar_arrays": 3,
          "wind_turbines": 2,
          "storage_banks": 2,
          "interconnects": 2,
          "emergency_mode": true,
          "duplicate_bid": false,
          "market_zone": 4
        },
        "request_headers": {
          "x-grid-key": "grid-045"
        },
        "expected_status": 400,
        "expected_error": "invalid_json"
      },
      {
        "id": "microgrid_bid_browser_hidden_1",
        "visibility": "hidden",
        "target": "browser",
        "export": "microgrid_bid_score",
        "args": [
          1,
          1,
          1,
          2,
          false
        ],
        "expected": 25
      },
      {
        "id": "microgrid_bid_browser_hidden_2",
        "visibility": "hidden",
        "target": "browser",
        "export": "microgrid_bid_score",
        "args": [
          7,
          5,
          2,
          1,
          true
        ],
        "expected": 439
      }
    ],
